# cloud-init network-config v2: interfaces matched by MAC and renamed, so the NIC order on
# the host does not matter.
version: 2
ethernets:
%{ for name, nic in nics ~}
  ${name}:
    match:
      macaddress: "${nic.mac}"
    set-name: ${name}
    addresses: [${nic.address}]
%{ if name == "wan" ~}
    routes:
      - to: default
        via: 10.255.255.1
    nameservers:
      # The router resolves through public resolvers, not through its own Unbound, so apt and
      # chrony keep working when Unbound is broken (ADR-0028 Updates, 2026-11-23).
      addresses: [1.1.1.1, 9.9.9.9]
%{ endif ~}
%{ endfor ~}
