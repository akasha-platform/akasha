# {{ ansible_managed }}
# The host routes between Tailscale, the lab (via OPNsense) and the uplink (ADR-0008).
# IPv6 forwarding stays off: the lab is IPv4-only, and forwarding would stop the uplink
# from accepting router advertisements.
net.ipv4.ip_forward = 1

# No IPv6 (not even link-local) on the lab bridges: the host must not be reachable from
# lab VMs or floating IPs over IPv6. systemd-sysctl applies these keys when each interface
# appears (udev rule 99-systemd.rules).
{% for bridge in host_network_bridges %}
net.ipv6.conf.{{ bridge.name }}.disable_ipv6 = 1
{% endfor %}
