# {{ ansible_managed }}
# Private configuration of core's backup (ADR-0049). Root only; from a private file.
AWS_ACCESS_KEY_ID={{ openbao_backup_aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ openbao_backup_aws_secret_access_key }}
AWS_DEFAULT_REGION={{ openbao_backup_region }}
RESTIC_REPOSITORY=s3:https://s3.{{ openbao_backup_region }}.amazonaws.com/{{ openbao_backup_bucket }}/{{ openbao_backup_repository_path }}
RESTIC_PASSWORD_FILE={{ openbao_backup_config_dir }}/restic-password
RESTIC_CACHE_DIR={{ openbao_backup_cache_dir }}
