#!/bin/bash
# {{ ansible_managed }}
# Give core's backup its OpenBao identity (ADR-0049, runbook backups.md), as root:
#   <admin token on stdin> | ssh debian@core sudo akasha-bao-approle
# Reads the AppRole's role ID, generates a new secret ID and writes both in root-only files,
# then destroys every older secret ID of the role (rotation). The secret never leaves core and
# never appears on a command line; the admin's token is revoked at the end.
set -euo pipefail
umask 077
export BAO_ADDR=http://{{ openbao_api_address | default('127.0.0.1:8200') }}
role={{ openbao_backup_approle }}
dir={{ openbao_backup_config_dir }}

IFS= read -r BAO_TOKEN || true
if [ -z "$BAO_TOKEN" ]; then
  echo "expected the admin's token on standard input" >&2
  exit 1
fi
export BAO_TOKEN
trap 'bao token revoke -self >/dev/null 2>&1 || true' EXIT

install -d -o root -g root -m 0700 "$dir"
bao read -field=role_id "auth/approle/role/$role/role-id" > "$dir/approle-role-id.new"
response=$(bao write -f -format=json "auth/approle/role/$role/secret-id")
field() { printf '%s' "$response" | python3 -c "import json, sys; print(json.load(sys.stdin)['data']['$1'])"; }
field secret_id > "$dir/approle-secret-id.new"
accessor=$(field secret_id_accessor)
unset response
mv "$dir/approle-role-id.new" "$dir/approle-role-id"
mv "$dir/approle-secret-id.new" "$dir/approle-secret-id"

# Destroy the older secret IDs: only the new one logs in from now on.
for old in $(bao list -format=json "auth/approle/role/$role/secret-id" \
    | python3 -c 'import json, sys; print("\n".join(json.load(sys.stdin)))'); do
  if [ "$old" != "$accessor" ]; then
    bao write "auth/approle/role/$role/secret-id-accessor/destroy" secret_id_accessor="$old" >/dev/null
    echo "destroyed an older secret ID"
  fi
done
echo "AppRole $role: new secret ID written to $dir"
