# {{ ansible_managed }}
# OpenBao on core (ADR-0011, ADR-0039, role openbao). Replaces the package's example file
# (pebbledb, TLS listener on 0.0.0.0).

ui = false

storage "raft" {
  path    = "{{ openbao_data_dir }}/raft"
  node_id = "{{ openbao_node_id }}"
}

# Loopback, without TLS: the unseal and bootstrap helpers, the admin over SSH and OpenTofu's
# SSH tunnel (ADR-0039, ADR-0046). A certificate cannot name 127.0.0.1 (the root's name
# constraints, ADR-0044), and nothing but core itself reaches this address. Break-glass: a new
# root token from two unseal shares (`bao operator generate-root`) works here without a token
# (ADR-0047); it stays disabled on the network listener.
listener "tcp" {
  address         = "{{ openbao_api_address }}"
  cluster_address = "{{ openbao_cluster_address }}"
  tls_disable     = true

  disable_unauthed_generate_root_endpoints = false
}
{% if openbao_tls_active | default(false) | bool %}

# The lab's address, TLS 1.3 only, with a certificate from OpenBao's own PKI, issued by
# akasha-bao-tls (ADR-0047), present on the data disk. The firewall of core lets only the
# bastion in.
# Every TCP listener opens a cluster port too (its port + 1 by default): keep it on loopback,
# apart from the first listener's.
listener "tcp" {
  address         = "{{ openbao_tls_address }}"
  cluster_address = "{{ openbao_tls_cluster_address }}"
  tls_cert_file   = "{{ openbao_tls_dir }}/openbao.crt"
  tls_key_file    = "{{ openbao_tls_dir }}/openbao.key"
  tls_min_version = "tls13"
}

api_addr     = "https://{{ openbao_tls_names[0] }}:{{ openbao_tls_address.split(':')[1] }}"
{% else %}

api_addr     = "http://{{ openbao_api_address }}"
{% endif %}
cluster_addr = "https://{{ openbao_cluster_address }}"

# Every request and response, with secrets HMAC'd, on the data disk (ADR-0045). Declared here:
# OpenBao refuses API-created audit devices (2.3.2+). It enables the device at each unseal, and
# answers no request it cannot audit. logrotate rotates the file and sends SIGHUP to reopen it.
audit "file" "file" {
  description = "Every request and response, on the data disk (ADR-0045)."
  options {
    file_path = "{{ openbao_audit_dir }}/audit.log"
    mode      = "0600"
  }
}
