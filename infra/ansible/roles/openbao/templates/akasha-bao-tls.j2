#!/bin/bash
# {{ ansible_managed }}
# Issue OpenBao's own TLS certificate from its PKI (ADR-0047, runbook core.md), as root:
#   <admin token on stdin> | ssh debian@core sudo akasha-bao-tls
# Reads the admin's token from standard input, asks the role `server` for one year, checks the
# chain against the root CA in the system trust store and that the key matches, then puts the
# key (root:openbao 0640) and the certificate with its intermediate in {{ openbao_tls_dir }}.
# A running OpenBao is reloaded (SIGHUP reloads the listener's certificate). The key exists
# only in memory and in that file; the token never appears on a command line.
set -euo pipefail
umask 077

names="{{ openbao_tls_names | join(',') }}"
ips="{{ openbao_tls_ips | join(',') }}"
dir="{{ openbao_tls_dir }}"
root_ca=/usr/local/share/ca-certificates/akasha-root-ca.crt

IFS= read -r BAO_TOKEN || true
if [ -z "$BAO_TOKEN" ]; then
  echo "expected the admin's token on standard input" >&2
  exit 1
fi
export BAO_TOKEN BAO_ADDR=http://{{ openbao_api_address }}
if [ ! -s "$root_ca" ]; then
  echo "$root_ca is missing: run the role lab_trust first" >&2
  exit 1
fi

response=$(bao write -format=json pki/issue/server common_name="${names%%,*}" \
  alt_names="$names" ip_sans="$ips" ttl=8760h)
field() { printf '%s' "$response" | python3 -c "import json, sys; print(json.load(sys.stdin)['data']['$1'])"; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
field certificate > "$work/leaf.pem"
field issuing_ca > "$work/intermediate.pem"
field private_key > "$work/openbao.key"
unset response

openssl verify -CAfile "$root_ca" -untrusted "$work/intermediate.pem" "$work/leaf.pem" >/dev/null
if ! cmp -s <(openssl x509 -in "$work/leaf.pem" -noout -pubkey) <(openssl pkey -in "$work/openbao.key" -pubout); then
  echo "the private key does not match the certificate" >&2
  exit 1
fi
cat "$work/leaf.pem" "$work/intermediate.pem" > "$work/openbao.crt"

install -d -o root -g openbao -m 0750 "$dir"
install -o root -g openbao -m 0640 "$work/openbao.key" "$dir/openbao.key.new"
install -o root -g openbao -m 0644 "$work/openbao.crt" "$dir/openbao.crt.new"
mv "$dir/openbao.key.new" "$dir/openbao.key"
mv "$dir/openbao.crt.new" "$dir/openbao.crt"

if systemctl is-active --quiet openbao.service; then
  systemctl reload openbao.service
fi
openssl x509 -in "$dir/openbao.crt" -noout -subject -enddate -fingerprint -sha256 -ext subjectAltName
