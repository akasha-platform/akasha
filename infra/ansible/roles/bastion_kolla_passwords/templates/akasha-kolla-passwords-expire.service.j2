# {{ ansible_managed }}
[Unit]
Description=akasha: remove a copy of Kolla's passwords older than {{ bastion_kolla_passwords_max_age_minutes }} minutes (ADR-0052)
Documentation=https://github.com/akasha-platform/akasha/blob/main/docs/runbooks/bastion.md
RequiresMountsFor={{ bastion_kolla_passwords_dir }}

[Service]
Type=oneshot
ExecStart=/usr/bin/find {{ bastion_kolla_passwords_dir }} -xdev -type f -mmin +{{ bastion_kolla_passwords_max_age_minutes }} -print -delete
ProtectSystem=strict
ReadWritePaths={{ bastion_kolla_passwords_dir }}
ProtectHome=true
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
RestrictAddressFamilies=none
ProtectKernelTunables=true
ProtectKernelModules=true
# Root needs to pass the directory's mode 0700 (it belongs to the toolchain user), nothing else.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
