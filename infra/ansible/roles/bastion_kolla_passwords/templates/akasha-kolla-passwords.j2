#!/bin/bash
# {{ ansible_managed }}
# Kolla-Ansible's passwords (ADR-0052) and the APIs' TLS certificate (ADR-0053), runbook
# bastion.md. Run as {{ bastion_kolla_passwords_user }}, with the
# operator's password on standard input, from the laptop:
#   tofu_passphrase.py --service akasha-openbao --plain operator \
#     | ssh debian@10.10.0.10 'sudo -iu {{ bastion_kolla_passwords_user }} akasha-kolla-passwords read'
# Modes:
#   read   copy the passwords from OpenBao into {{ bastion_kolla_passwords_dir }} (a tmpfs without swap)
#          and link infra/kolla/passwords.yml to it; fails if one is missing. Also writes
#          HAProxy's and ProxySQL's certificate files to {{ bastion_kolla_passwords_dir }}/certificates
#          (Kolla's kolla_certificates_dir), only after checking the chain, the key, the names
#          and the expiry;
#   init   once: generate the passwords there, write them to OpenBao, read them back and
#          compare, then remove the copy; refuses when OpenBao already holds one;
#   clean  remove everything on the tmpfs (the copy, the certificate files, Ansible's temporary
#          files), the link,
#          and the credentials kolla-ansible post-deploy writes (no password needed).
# Logs in to OpenBao as `{{ bastion_kolla_passwords_openbao_user }}` and revokes the token at the end. The token
# reaches Kolla's code through the environment, never a command line.
set -euo pipefail
umask 077
ulimit -c 0 # no core dump of a process that holds the passwords
if [ "$(id -un)" != "{{ bastion_kolla_passwords_user }}" ]; then
  echo "run as {{ bastion_kolla_passwords_user }}: sudo -iu {{ bastion_kolla_passwords_user }} akasha-kolla-passwords <mode>" >&2
  exit 1
fi
mode=${1:-}
repo=$HOME/akasha
kolla=$repo/infra/kolla
ram={{ bastion_kolla_passwords_dir }}
copy=$ram/passwords.yml
link=$kolla/passwords.yml

# The copy and its link, and what post-deploy writes next to them (git-ignored).
remove_all() {
  if mountpoint -q "$ram"; then find "$ram" -mindepth 1 -delete; fi
  if [ -L "$link" ]; then rm -f "$link"; fi
  # kolla-genpwd, kolla-readpwd and kolla-mergepwd replace a link with a plain file.
  if [ -f "$link" ]; then
    rm -f "$link"
    echo "WARNING: $link was a plain file on the disk (a Kolla password tool run on it): removed," \
      "but its blocks may remain on the disk" >&2
  fi
  rm -f "$kolla/clouds.yaml" "$kolla"/*openrc*.sh
}

case "$mode" in
  clean)
    remove_all
    echo "removed the copy, the link and Kolla's credential files"
    exit 0
    ;;
  read | init) ;;
  *)
    echo "usage: akasha-kolla-passwords read|init|clean" >&2
    exit 2
    ;;
esac

# The passwords are only ever written to this tmpfs, never to a disk or to swap.
if ! findmnt -n -o FSTYPE,OPTIONS --mountpoint "$ram" | grep -Eq '^tmpfs +(.*,)?noswap(,|$)'; then
  echo "$ram is not the tmpfs without swap (role bastion_kolla_passwords): nothing was done" >&2
  exit 1
fi
if [ -e "$link" ] && [ ! -L "$link" ]; then
  echo "$link is a plain file on the disk, not the link to $copy (a Kolla password tool run" \
    "on it?): akasha-kolla-passwords clean removes it" >&2
  exit 1
fi
# A failed read must never leave an older copy for Kolla to use.
# Nor leave the copies of a run that was killed (the OOM killer, on a small VM).
if [ "$mode" = read ]; then
  rm -rf "$copy" "$ram"/*.tmp "$ram/certificates"
  if [ -L "$link" ]; then rm -f "$link"; fi
fi

# Never typed on the bastion: a terminal would echo it.
if [ -t 0 ]; then
  echo "pipe the operator's password from the laptop (runbook bastion.md), never type it here" >&2
  exit 1
fi
IFS= read -r password || true
if [ -z "$password" ]; then
  echo "expected the operator's password on standard input" >&2
  exit 1
fi

cd "$repo" # mise and uv run the bao CLI and Kolla pinned in mise.lock and uv.lock
export BAO_ADDR={{ bastion_kolla_passwords_openbao_addr }}
BAO_TOKEN=$(printf '%s' "$password" | BAO_TOKEN='' mise exec -- bao login -no-store -token-only \
  -method=userpass username={{ bastion_kolla_passwords_openbao_user }} password=-)
unset password
export BAO_TOKEN
trap 'mise exec -- bao token revoke -self >/dev/null 2>&1 || true' EXIT

# Kolla's own functions, from the installed release: its template lists every password name.
template=$(mise exec -- uv run --locked --group kolla python -c \
  'import kolla_ansible.utils as u; print(u.get_data_files_path("etc_examples", "kolla", "passwords.yml"))')
mise exec -- uv run --locked --group kolla python - "$mode" "$template" "$ram" "{{ bastion_kolla_passwords_root_ca }}" <<'PY'
import ipaddress
import os
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone

import hvac
import yaml
from cryptography import x509
from cryptography.hazmat.primitives import serialization
from cryptography.x509.verification import PolicyBuilder, Store, VerificationError
from kolla_ansible.cmd.readpwd import readpwd
from kolla_ansible.cmd.writepwd import writepwd
from kolla_ansible.hashi_vault import hashicorp_vault_client

mode, template, ram, root_file = sys.argv[1:5]
vault = dict(
    vault_kv_path="{{ bastion_kolla_passwords_path }}",
    vault_mount_point="{{ bastion_kolla_passwords_mount }}",
    vault_namespace="",
    vault_addr=os.environ["BAO_ADDR"],
    vault_role_id="",
    vault_secret_id="",
    vault_token=os.environ["BAO_TOKEN"],
    vault_cacert="{{ bastion_kolla_passwords_ca_file }}",
)
# kolla-genpwd leaves these empty on purpose (blank_keys in kolla_ansible/cmd/genpwd.py; check
# it at every bump of Kolla).
BLANK = {"docker_registry_password"}
# The APIs' certificate (ADR-0053).
TLS_PATH = "{{ bastion_kolla_passwords_tls_path }}"
TLS_NAMES = {{ bastion_kolla_passwords_tls_names | to_json }}
TLS_ADDRESSES = {{ bastion_kolla_passwords_tls_addresses | to_json }}
TLS_WARN = timedelta(days={{ bastion_kolla_passwords_tls_warn_days | int }})
TLS_MIN = timedelta(days={{ bastion_kolla_passwords_tls_min_days | int }})
mine = []  # this run's temporary files and directories, removed at the end whatever happens


def fresh():
    """A copy of the template on the tmpfs, only readable by its owner."""
    fd, path = tempfile.mkstemp(dir=ram, suffix=".tmp")
    os.close(fd)
    mine.append(path)
    shutil.copyfile(template, path)
    os.chmod(path, 0o600)
    return path


def client():
    return hashicorp_vault_client(**{k: v for k, v in vault.items()
                                     if k not in ("vault_kv_path", "vault_mount_point")})


def spki(public_key):
    return public_key.public_bytes(serialization.Encoding.DER,
                                   serialization.PublicFormat.SubjectPublicKeyInfo)


def days(delta):
    """Whole days, rounded up: a fresh one-year certificate shows 365."""
    return -(-delta // timedelta(days=1))


def certificates():
    """HAProxy's and ProxySQL's files in a new directory on the tmpfs, after the checks; never
    prints the key."""
    where = f"{vault['vault_mount_point']}/{TLS_PATH}"
    try:
        secret = client().secrets.kv.v2.read_secret_version(
            path=TLS_PATH, mount_point=vault["vault_mount_point"],
            raise_on_deleted_version=True)["data"]["data"]
    except hvac.exceptions.InvalidPath:
        sys.exit(f"read: no certificate at {where} (runbook openbao-pki.md): nothing was written")
    except hvac.exceptions.Forbidden:
        sys.exit(f"read: permission denied on {where}: the operator lacks the policy kolla-tls "
                 "(stack openbao, runbook openbao-pki.md): nothing was written")
    try:
        leaf = x509.load_pem_x509_certificate(secret["certificate"].encode())
        issuer = x509.load_pem_x509_certificate(secret["issuing_ca"].encode())
        key = serialization.load_pem_private_key(secret["private_key"].encode(), password=None)
    except (KeyError, AttributeError, TypeError, ValueError) as e:
        sys.exit(f"read: {where} does not hold a PEM certificate, issuing_ca and private_key "
                 f"({type(e).__name__}): nothing was written")
    with open(root_file, "rb") as f:
        root = x509.load_pem_x509_certificate(f.read())
    if spki(key.public_key()) != spki(leaf.public_key()):
        sys.exit(f"read: the key at {where} does not match its certificate: nothing was written")
    now = datetime.now(timezone.utc)
    expiry = leaf.not_valid_after_utc
    if expiry - now < TLS_MIN:
        sys.exit(f"read: the APIs' certificate expires on {expiry:%Y-%m-%d}, in less than "
                 f"{TLS_MIN.days} days: renew it (runbook openbao-pki.md): nothing was written")
    # The chain to the lab's root, the name constraints, the dates, serverAuth and each name.
    store = Store([root])
    subjects = ([x509.DNSName(n) for n in TLS_NAMES]
                + [x509.IPAddress(ipaddress.ip_address(a)) for a in TLS_ADDRESSES])
    for subject in subjects:
        try:
            PolicyBuilder().store(store).time(now).build_server_verifier(subject).verify(
                leaf, [issuer])
        except VerificationError as e:
            sys.exit(f"read: the APIs' certificate does not verify for {subject.value}: {e}: "
                     "nothing was written")
    if expiry - now < TLS_WARN:
        print(f"WARNING: the APIs' certificate expires on {expiry:%Y-%m-%d}, in "
              f"{days(expiry - now)} days: renew it (runbook openbao-pki.md)", file=sys.stderr)
    new = tempfile.mkdtemp(dir=ram, suffix=".tmp")
    mine.append(new)
    os.mkdir(os.path.join(new, "ca"), 0o700)
    pem = {k: secret[k].strip() + "\n" for k in ("certificate", "issuing_ca", "private_key")}
    files = {
        # HAProxy, on both VIPs: the certificate, its chain and the key in one file.
        "haproxy.pem": pem["certificate"] + pem["issuing_ca"] + pem["private_key"],
        "haproxy-internal.pem": pem["certificate"] + pem["issuing_ca"] + pem["private_key"],
        # ProxySQL, MariaDB's TLS on the internal VIP (database_enable_tls_internal): the
        # certificate, the key, and the intermediate that signed it (Kolla's release note
        # fix-proxysql-database-internal-tls).
        "proxysql-cert.pem": pem["certificate"],
        "proxysql-key.pem": pem["private_key"],
        "proxysql-ca.pem": pem["issuing_ca"],
    }
    for name, content in files.items():
        fd = os.open(os.path.join(new, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(content)
    shutil.copyfile(root_file, os.path.join(new, "ca", "akasha-root-ca.crt"))
    return new, f"certificate valid until {expiry:%Y-%m-%d} ({days(expiry - now)} days)"


def load(path):
    with open(path) as f:
        return yaml.safe_load(f)


def missing(passwords):
    return sorted(k for k, v in passwords.items() if not v and k not in BLANK)


try:
    if mode == "init":
        try:
            names = client().secrets.kv.v2.list_secrets(
                path=vault["vault_kv_path"], mount_point=vault["vault_mount_point"])["data"]["keys"]
        except hvac.exceptions.InvalidPath:
            names = []
        if names:
            sys.exit(f"init: OpenBao already holds {len(names)} passwords at "
                     f"{vault['vault_mount_point']}/{vault['vault_kv_path']}: nothing was written")
        new = fresh()
        subprocess.run(["kolla-genpwd", "-p", new], check=True, stdout=subprocess.DEVNULL)
        generated = load(new)
        if missing(generated):
            sys.exit(f"init: kolla-genpwd left {missing(generated)} empty: nothing was written")
        writepwd(new, **vault)
        back = fresh()
        readpwd(back, **vault)
        if ({k: v or None for k, v in generated.items()}
                != {k: v or None for k, v in load(back).items()}):
            sys.exit("init: the passwords read back differ from those written (runbook bastion.md)")
        written = sum(1 for v in generated.values() if v)
        print(f"init: {written} passwords written to OpenBao and read back identical "
              f"({len(generated) - written} left blank on purpose)")
    else:
        tmp = fresh()
        readpwd(tmp, **vault)
        passwords = load(tmp)
        if missing(passwords):
            sys.exit(f"read: missing in OpenBao: {missing(passwords)} (a newer Kolla release: "
                     "merge its new passwords first)")
        new, valid = certificates()
        # The certificates first: a failure then leaves no passwords.yml behind either.
        os.rename(new, os.path.join(ram, "certificates"))
        mine.remove(new)
        os.replace(tmp, os.path.join(ram, "passwords.yml"))
        mine.remove(tmp)
        print(f"read: {len(passwords)} passwords; the APIs' {valid}")
finally:
    for path in mine:
        if os.path.isdir(path):
            shutil.rmtree(path)
        elif os.path.exists(path):
            os.remove(path)
PY

if [ "$mode" = read ]; then
  ln -sfn "$copy" "$link"
  echo "linked $link; run akasha-kolla-passwords clean when done (removed anyway after {{ bastion_kolla_passwords_max_age_minutes // 60 }} hours)"
fi
